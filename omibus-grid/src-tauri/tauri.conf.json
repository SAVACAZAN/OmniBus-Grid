{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omibus Grid",
  "version": "0.1.0",
  "identifier": "com.omibus.grid",
  "build": {
    "frontendDist": "../ui-vue/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Omibus Grid · AI Research 3",
      "width": 1360,
      "height": 880,
      "minWidth": 930,
      "minHeight": 650
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src https://www.tradingview-widget.com; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "resources": { "../ai-worker/": "ai-worker/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
